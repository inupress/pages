{
    "name": "inupress/pages",
    "description": "Static pages for Inupress: admin resource and public route",
    "type": "inupress-plugin",
    "keywords": ["inupress", "inupress-plugin"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inupress/contracts": "^0.1",
        "inupress/core": "^0.1",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Inupress\\Pages\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Inupress\\Pages\\PagesServiceProvider"
            ]
        }
    }
}
